{
  "name": "sound-archive-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm run check:tokens && npm run check:contrast && npm run test",
    "e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "supercluster": "9.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
