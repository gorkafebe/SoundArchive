# Sound Archive configuration.
#
# Copy this file to .env and edit it:   cp .env.example .env
# .env is ignored by git. Never commit real passwords.
#
# The values below are placeholders. They work as-is for local development,
# but on the MSI (production) you MUST replace every password.
# One way to generate a strong password:   openssl rand -base64 32 | tr -d '/+='

# --- Database: administrator ------------------------------------------------
# Superuser created by the Postgres image the first time the database starts.
# Used only by the db container itself and by the one-shot "migrate" service
# (schema changes need these powers). The API never uses this account.
POSTGRES_USER=sound_admin
POSTGRES_PASSWORD=change-me-admin-password
POSTGRES_DB=sound_archive

# --- Database: application user ---------------------------------------------
# Limited user the API connects with. It can read and write rows in tables,
# but cannot create, alter or drop tables. Created by
# infra/postgres/init/20-create-app-user.sh on the first start.
APP_DB_USER=sound_app
APP_DB_PASSWORD=change-me-app-password

# IMPORTANT: the four values above are only applied when the database is
# created for the first time (empty data directory). Changing them later
# does not change the existing database. See docs/DEV_SETUP.md, "Reset".

# --- Database: where the data lives ------------------------------------------
# Leave unset to use a Docker named volume called "db_data" (recommended in dev).
# On the MSI, set an absolute path to put the data on a larger disk, e.g.:
# DB_DATA_DIR=/srv/sound-archive/postgres
# DB_DATA_DIR=

# --- Dev only: ports on this laptop -------------------------------------------
# Port for the website + API in dev (http://localhost:8080).
DEV_HTTP_PORT=8080
# Network interface for that port. 127.0.0.1 (the default) = this computer
# only. 0.0.0.0 = every interface, so a phone on the same Wi-Fi can open
# http://<laptop-IP>:8080. Use 0.0.0.0 only on the dev laptop, never on the MSI.
# DEV_HTTP_BIND=0.0.0.0
# Port of the optional live-reload server (make web-dev), same interface.
# DEV_WEB_PORT=5173
# Port for database GUI tools in dev. Bound to 127.0.0.1 only.
# 5433, not Postgres's usual 5432, so it doesn't clash with a Postgres
# installed directly on the laptop.
DEV_DB_PORT=5433

# --- Who may create places -----------------------------------------------------
# There are no user accounts yet (they arrive in phase 6, by invitation). Until
# then, "true" lets ANYONE who reaches the site create places, with no login.
#   false (the default): POST /api/places answers 403, and the web app shows
#                        "creating places is disabled on this server".
#   true:                anyone can create places.
# The dev stack sets true by itself (compose.dev.yaml); there, set false here
# to try the disabled state. On the MSI leave it false until you know who can
# reach the site (see docs/DEPLOY_MSI.md, section 6).
# ALLOW_ANONYMOUS_WRITES=false

# --- Basemap -------------------------------------------------------------------
# MapLibre style URLs for the light and dark themes. The defaults are
# OpenFreeMap (no key, no sign-up): "positron" (light grey) and "dark".
# Changing them switches the map provider without rebuilding anything:
# edit, then `make up` (dev) or `make prod-up` (prod) re-creates the api.
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# The server(s) those styles load tiles, fonts and icons from. The page's
# Content-Security-Policy (infra/caddy/Caddyfile) only allows these, so a new
# provider must be listed here too (space-separated). Then re-create Caddy.
# MAP_TILE_ORIGINS=https://tiles.openfreemap.org

# --- Web server (Caddy) ------------------------------------------------------
# Which address Caddy serves.
#   :80              plain HTTP on any hostname/IP (use this with Tailscale)
#   archive.example  a real domain: Caddy gets an HTTPS certificate from
#                    Let's Encrypt automatically. See docs/DEPLOY_MSI.md.
CADDY_SITE_ADDRESS=:80

# --- Tailnet instance (compose.tailnet.yaml) -----------------------------------
# The MagicDNS name of this machine (tailscale serve status shows it). It goes
# on the HTTPS certificate and in the list of allowed browser origins.
# TAILNET_FQDN=machine.your-tailnet.ts.net
# Ports on 127.0.0.1. The Tailscale forward points at the HTTPS one.
# TAILNET_HTTPS_PORT=9443
# TAILNET_HTTP_PORT=9080
