# --- Secrets and local configuration ---------------------------------------
# .env holds real passwords. Only .env.example (placeholders) is committed.
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- JavaScript (the React app in web/) ------------------------------------
node_modules/
web/dist/
web/playwright-report/
web/test-results/

# --- Local data directories ------------------------------------------------
# If you point DB_DATA_DIR (or later, file storage) inside the repo, use one of
# these folder names so the data never ends up in git.
data/
.data/
pgdata/

# --- Editors ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# --- Operating systems -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Local agent instructions ----------------------------------------------
# Personal, machine-local instructions for the coding assistant. Never committed.
CLAUDE.local.md

# --- Technical guide (safety net) ------------------------------------------
# The LaTeX study guide lives OUTSIDE this repository, in ../SoundArchive-Guia/,
# so git never sees it. These rules only matter if the folder or its build
# files ever end up inside this working tree by mistake.
SoundArchive-Guia/
*.aux
*.log
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# --- Design export kept on disk (its contents are in docs/design/handoff/) ---
docs/design/design-handoff.zip
